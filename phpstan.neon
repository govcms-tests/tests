parameters:
    level: 6

    paths:
        - ..

    fileExtensions:
        - php
        - module
        - inc
        - install
        - profile
        - theme
        - engine
        - test

    excludePaths:
        analyseAndScan:
            - ../tests/*
            - ../vendor/*
            - ../web/*
            - ../bin/*
            - ../node_modules/*
            - ../.git/*